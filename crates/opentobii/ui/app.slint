// The opentobii tuning window. All numbers are formatted in Rust and all
// state lives there; this file is layout and looks.

import { AboutSlint, Button, ComboBox, ScrollView, Slider, Switch } from "std-widgets.slint";

global Theme {
    out property <color> window: #14161b;
    out property <color> card: #1c1f26;
    out property <color> card-line: #2a2e38;
    out property <color> inset: #101216;
    out property <color> text: #e6e8ee;
    out property <color> muted: #8b92a3;
    // The Fluent style's own accent, so sliders and our drawing agree.
    out property <color> accent: #60cdff;
    out property <color> raw: #6d7486;
    out property <color> good: #3ecfb2;
    out property <color> bad: #e5695f;
    out property <color> idle: #5a6072;
    out property <length> radius: 10px;
}

export struct CheckRow {
    text: string,
    detail: string,
    done: bool,
    // The label of the button that fixes it, or empty for none.
    action: string,
    busy: bool,
}

export struct GameRow {
    name: string,
    state: string,
    // What the main button does: "Set up", "Update", or empty for none.
    action: string,
    removable: bool,
    busy: bool,
}

export struct AxisRow {
    name: string,
    dead-zone: float,
    dead-zone-max: float,
    dead-zone-text: string,
    sensitivity: float,
    sensitivity-text: string,
    curve: float,
    curve-text: string,
    limit: float,
    limit-max: float,
    limit-text: string,
    invert: bool,
    raw-text: string,
    out-text: string,
}

component Card inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    background: Theme.card;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.card-line;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 10px;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: 15px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Text {
                text: root.hint;
                color: Theme.muted;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }
        @children
    }
}

component Pill inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> dot;
    height: 30px;
    horizontal-stretch: 0;
    border-radius: 15px;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.card-line;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.dot;
            }
        }
        Text {
            text: root.label;
            color: Theme.muted;
            font-size: 12px;
            vertical-alignment: center;
        }
        Text {
            text: root.value;
            color: Theme.text;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

component Setting inherits HorizontalLayout {
    in property <string> label;
    in property <string> value-text;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <float> value;
    in property <bool> enabled: true;
    callback changed(float);
    spacing: 12px;
    height: 30px;
    Text {
        text: root.label;
        color: root.enabled ? Theme.text : Theme.muted;
        font-size: 13px;
        vertical-alignment: center;
        width: 96px;
    }
    Slider {
        minimum: root.minimum;
        maximum: root.maximum;
        value: root.value;
        enabled: root.enabled;
        horizontal-stretch: 1;
        changed(v) => {
            root.changed(v);
        }
    }
    Text {
        text: root.value-text;
        color: root.enabled ? Theme.accent : Theme.muted;
        font-size: 13px;
        font-weight: 600;
        vertical-alignment: center;
        horizontal-alignment: right;
        width: 76px;
    }
}

component AxisEditor inherits Rectangle {
    in property <AxisRow> axis;
    in property <string> unit;
    callback changed(string, float);
    callback invert(bool);
    background: Theme.inset;
    border-radius: 8px;
    VerticalLayout {
        padding: 12px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 10px;
            height: 26px;
            Text {
                text: root.axis.name;
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
                width: 60px;
            }
            Text {
                text: root.axis.raw-text + "  →  " + root.axis.out-text;
                color: Theme.muted;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Switch {
                text: "Invert";
                checked: root.axis.invert;
                toggled => {
                    root.invert(self.checked);
                }
            }
        }
        Setting {
            label: "Dead zone";
            maximum: root.axis.dead-zone-max;
            value: root.axis.dead-zone;
            value-text: root.axis.dead-zone-text;
            changed(v) => {
                root.changed("dead_zone", v);
            }
        }
        Setting {
            label: "Sensitivity";
            maximum: 5;
            value: root.axis.sensitivity;
            value-text: root.axis.sensitivity-text;
            changed(v) => {
                root.changed("sensitivity", v);
            }
        }
        Setting {
            label: "Curve";
            minimum: 0.5;
            maximum: 3;
            value: root.axis.curve;
            value-text: root.axis.curve-text;
            changed(v) => {
                root.changed("curve", v);
            }
        }
        Setting {
            label: "Limit";
            maximum: root.axis.limit-max;
            value: root.axis.limit;
            value-text: root.axis.limit-text;
            changed(v) => {
                root.changed("limit", v);
            }
        }
    }
}

// Where the head points: yaw across, pitch up and down. The faint dot is
// what the tracker sees, the bright one is what the game gets.
component LookPad inherits Rectangle {
    in property <float> raw-x;
    in property <float> raw-y;
    in property <float> out-x;
    in property <float> out-y;
    in property <float> dead-x;
    in property <float> dead-y;
    in property <float> roll;
    in property <bool> live;
    background: Theme.inset;
    border-radius: 8px;
    clip: true;
    min-height: 220px;
    Rectangle {
        x: 0;
        y: parent.height / 2;
        width: parent.width;
        height: 1px;
        background: Theme.card-line;
    }
    Rectangle {
        x: parent.width / 2;
        y: 0;
        width: 1px;
        height: parent.height;
        background: Theme.card-line;
    }
    Rectangle {
        width: max(2px, root.dead-x * parent.width);
        height: max(2px, root.dead-y * parent.height);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 4px;
        background: #60cdff1a;
        border-width: 1px;
        border-color: #60cdff55;
        visible: root.dead-x > 0 || root.dead-y > 0;
    }
    Rectangle {
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.raw;
        x: parent.width / 2 + root.raw-x * parent.width / 2 - 6px;
        y: parent.height / 2 - root.raw-y * parent.height / 2 - 6px;
        visible: root.live;
    }
    Rectangle {
        width: 44px;
        height: 3px;
        border-radius: 1.5px;
        background: Theme.accent;
        opacity: 0.55;
        x: parent.width / 2 + root.out-x * parent.width / 2 - 22px;
        y: parent.height / 2 - root.out-y * parent.height / 2 - 1.5px;
        transform-rotation: root.roll * 1deg;
        visible: root.live;
    }
    Rectangle {
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: Theme.accent;
        x: parent.width / 2 + root.out-x * parent.width / 2 - 8px;
        y: parent.height / 2 - root.out-y * parent.height / 2 - 8px;
        visible: root.live;
    }
    Text {
        text: "No head pose";
        color: Theme.muted;
        font-size: 13px;
        visible: !root.live;
    }
}

component Swatch inherits Rectangle {
    in property <color> fill;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback picked();
    width: 28px;
    height: 28px;
    border-radius: 14px;
    border-width: 2px;
    border-color: root.selected ? Theme.text : transparent;
    opacity: root.enabled ? 1 : 0.4;
    Rectangle {
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: root.fill;
    }
    TouchArea {
        enabled: root.enabled;
        clicked => {
            root.picked();
        }
    }
}

component Legend inherits HorizontalLayout {
    in property <color> dot;
    in property <string> label;
    spacing: 6px;
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 9px;
            height: 9px;
            border-radius: 4.5px;
            background: root.dot;
        }
    }
    Text {
        text: root.label;
        color: Theme.muted;
        font-size: 12px;
        vertical-alignment: center;
    }
}

export component App inherits Window {
    title: "opentobii";
    preferred-width: 1040px;
    preferred-height: 860px;
    min-width: 860px;
    min-height: 560px;
    background: Theme.window;
    default-font-size: 13px;

    in property <bool> daemon-connected;
    in property <bool> driver-connected;
    in property <bool> tracking;
    in property <string> tracker-text: "Not tracking";
    in property <string> game-text: "No game";
    in property <bool> game-connected;
    in property <string> notice;
    in property <string> version-text;
    in property <string> update-text;
    in property <string> update-notes;
    in property <bool> update-busy;
    in property <bool> update-possible;
    in property <string> update-status;
    in property <bool> update-checking;

    in property <[string]> profiles;
    in-out property <int> profile-index;
    in property <bool> can-create;
    in property <string> create-text;
    in property <bool> can-delete;

    in property <bool> smoothing-enabled;
    in property <float> steadiness;
    in property <string> steadiness-text;
    in property <float> response;
    in property <string> response-text;

    in property <[AxisRow]> rotation;
    in property <[AxisRow]> position;

    in property <float> look-raw-x;
    in property <float> look-raw-y;
    in property <float> look-out-x;
    in property <float> look-out-y;
    in property <float> look-dead-x;
    in property <float> look-dead-y;
    in property <float> look-roll;
    in property <string> look-range-text;

    in property <[CheckRow]> checklist;
    in property <bool> checklist-visible;

    in property <string> service-text;
    in property <bool> service-available;
    in property <bool> service-active;
    in property <bool> service-enabled;
    in property <bool> service-busy;

    in property <[GameRow]> games;
    in property <string> games-text;

    in property <bool> calibration-available;
    in property <string> calibration-text;
    in property <[string]> monitors;
    in-out property <int> monitor-index;
    in-out property <bool> keep-display-setup;
    in property <bool> calibrating;

    in property <bool> camera-enabled;
    in property <string> camera-status;
    in property <bool> overlay-enabled;
    in property <[string]> overlay-styles;
    in-out property <int> overlay-style-index;
    in property <[color]> overlay-colors;
    in property <int> overlay-color-index;
    in property <float> overlay-size;
    in property <string> overlay-size-text;
    in property <float> overlay-opacity;
    in property <string> overlay-opacity-text;
    in property <float> overlay-smoothing;
    in property <string> overlay-smoothing-text;
    in property <float> overlay-trail;
    in property <string> overlay-trail-text;

    callback profile-selected(int);
    callback create-profile();
    callback delete-profile();
    callback reset-profile();
    callback recentre();
    callback calibrate();
    callback checklist-action(int);
    callback update-now();
    callback check-updates();
    callback service-start();
    callback service-stop();
    callback service-restart();
    callback service-autostart(bool);
    callback game-action(int);
    callback game-remove(int);
    callback camera-toggled(bool);
    callback overlay-toggled(bool);
    callback overlay-style-selected(int);
    callback overlay-color-selected(int);
    callback overlay-size-changed(float);
    callback overlay-opacity-changed(float);
    callback overlay-smoothing-changed(float);
    callback overlay-trail-changed(float);
    callback smoothing-toggled(bool);
    callback steadiness-changed(float);
    callback response-changed(float);
    callback axis-changed(string, int, string, float);
    callback axis-invert(string, int, bool);

    about := PopupWindow {
        x: (root.width - 320px) / 2;
        y: (root.height - 330px) / 2;
        width: 320px;
        height: 330px;
        // A click on the button inside must not close the box.
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            background: Theme.card;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.card-line;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text {
                    text: "opentobii";
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Tobii Eye Tracker 5 for games under Proton.\nNot affiliated with Tobii. MIT licence.";
                    color: Theme.muted;
                    font-size: 12px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: root.version-text;
                    color: Theme.muted;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.update-status;
                    color: Theme.muted;
                    font-size: 12px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Button {
                    text: "Check for updates";
                    enabled: !root.update-checking;
                    clicked => {
                        root.check-updates();
                    }
                }
                AboutSlint { }
            }
        }
    }

    VerticalLayout {
        padding: 18px;
        spacing: 14px;

        HorizontalLayout {
            spacing: 10px;
            height: 34px;
            Text {
                text: "opentobii";
                color: Theme.text;
                font-size: 20px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Pill {
                label: "Daemon";
                value: root.daemon-connected ? "Running" : "Not running";
                dot: root.daemon-connected ? Theme.good : Theme.bad;
            }
            Pill {
                label: "Tracker";
                value: root.tracker-text;
                dot: root.tracking ? Theme.good : (root.driver-connected ? Theme.idle : Theme.bad);
            }
            Pill {
                label: "Game";
                value: root.game-text;
                dot: root.game-connected ? Theme.good : Theme.idle;
            }
            Button {
                text: "About";
                clicked => {
                    about.show();
                }
            }
        }

        if root.update-text != "": Rectangle {
            border-radius: 8px;
            background: #60cdff1c;
            border-width: 1px;
            border-color: #60cdff66;
            VerticalLayout {
                padding-left: 14px;
                padding-right: 6px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 4px;
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: root.update-text;
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    if root.update-possible: Button {
                        text: root.update-busy ? "Updating…" : "Update";
                        primary: true;
                        enabled: !root.update-busy;
                        clicked => {
                            root.update-now();
                        }
                    }
                }
                if root.update-notes != "": Text {
                    text: root.update-notes;
                    color: Theme.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }

        if root.notice != "": Rectangle {
            height: 40px;
            border-radius: 8px;
            background: #e5695f22;
            border-width: 1px;
            border-color: #e5695f66;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 6px;
                spacing: 10px;
                Text {
                    text: root.notice;
                    color: #f0a59e;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if !root.daemon-connected && root.service-available: VerticalLayout {
                    alignment: center;
                    Button {
                        text: root.service-busy ? "Starting…" : "Start it";
                        enabled: !root.service-busy;
                        clicked => {
                            root.service-start();
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 14px;

            ScrollView {
                width: 354px;
                VerticalLayout {
                    spacing: 14px;
                    padding-right: 14px;

                    if root.checklist-visible: Card {
                        title: "Getting started";
                        hint: "";
                        vertical-stretch: 0;
                        for item[i] in root.checklist: HorizontalLayout {
                            spacing: 10px;
                            VerticalLayout {
                                alignment: start;
                                padding-top: 3px;
                                Rectangle {
                                    width: 14px;
                                    height: 14px;
                                    border-radius: 7px;
                                    background: item.done ? Theme.good : transparent;
                                    border-width: 2px;
                                    border-color: item.done ? Theme.good : Theme.idle;
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                horizontal-stretch: 1;
                                Text {
                                    text: item.text;
                                    color: item.done ? Theme.muted : Theme.text;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                                if !item.done && item.detail != "": Text {
                                    text: item.detail;
                                    color: Theme.muted;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                                if !item.done && item.action != "": HorizontalLayout {
                                    alignment: start;
                                    Button {
                                        text: item.action;
                                        enabled: !item.busy;
                                        clicked => {
                                            root.checklist-action(i);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Card {
                        title: "Live view";
                        hint: root.look-range-text;
                        LookPad {
                            raw-x: root.look-raw-x;
                            raw-y: root.look-raw-y;
                            out-x: root.look-out-x;
                            out-y: root.look-out-y;
                            dead-x: root.look-dead-x;
                            dead-y: root.look-dead-y;
                            roll: root.look-roll;
                            live: root.tracking;
                        }
                        HorizontalLayout {
                            spacing: 16px;
                            alignment: start;
                            Legend {
                                dot: Theme.raw;
                                label: "Tracker";
                            }
                            Legend {
                                dot: Theme.accent;
                                label: "Sent to the game";
                            }
                        }
                        Button {
                            text: "Recentre: this is straight ahead";
                            primary: true;
                            enabled: root.tracking;
                            clicked => {
                                root.recentre();
                            }
                        }
                    }

                    Card {
                        title: "Profile";
                        hint: "";
                        vertical-stretch: 0;
                        ComboBox {
                            model: root.profiles;
                            current-index <=> root.profile-index;
                            selected => {
                                root.profile-selected(self.current-index);
                            }
                        }
                        if root.can-create: Button {
                            text: root.create-text;
                            clicked => {
                                root.create-profile();
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "Reset to defaults";
                                horizontal-stretch: 1;
                                clicked => {
                                    root.reset-profile();
                                }
                            }
                            Button {
                                text: "Delete profile";
                                horizontal-stretch: 1;
                                enabled: root.can-delete;
                                clicked => {
                                    root.delete-profile();
                                }
                            }
                        }
                    }

                    Card {
                        title: "Daemon";
                        hint: "";
                        vertical-stretch: 0;
                        Text {
                            text: root.service-text;
                            color: Theme.muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        if root.service-available: Switch {
                            text: "Start at login";
                            checked: root.service-enabled;
                            enabled: !root.service-busy;
                            toggled => {
                                root.service-autostart(self.checked);
                            }
                        }
                        if root.service-available: HorizontalLayout {
                            spacing: 8px;
                            if !root.daemon-connected: Button {
                                text: "Start";
                                primary: true;
                                horizontal-stretch: 1;
                                enabled: !root.service-busy;
                                clicked => {
                                    root.service-start();
                                }
                            }
                            if root.service-active: Button {
                                text: "Restart";
                                horizontal-stretch: 1;
                                enabled: !root.service-busy;
                                clicked => {
                                    root.service-restart();
                                }
                            }
                            if root.service-active: Button {
                                text: "Stop";
                                horizontal-stretch: 1;
                                enabled: !root.service-busy;
                                clicked => {
                                    root.service-stop();
                                }
                            }
                        }
                    }

                    Card {
                        title: "Games";
                        hint: "";
                        vertical-stretch: 0;
                        if root.games-text != "": Text {
                            text: root.games-text;
                            color: Theme.muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        for game[i] in root.games: Rectangle {
                            background: Theme.inset;
                            border-radius: 8px;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 6px;
                                Text {
                                    text: game.name;
                                    color: Theme.text;
                                    font-size: 13px;
                                    font-weight: 600;
                                    overflow: elide;
                                }
                                Text {
                                    text: game.state;
                                    color: Theme.muted;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                                if game.action != "" || game.removable: HorizontalLayout {
                                    spacing: 8px;
                                    if game.action != "": Button {
                                        text: game.action;
                                        primary: true;
                                        horizontal-stretch: 1;
                                        enabled: !game.busy;
                                        clicked => {
                                            root.game-action(i);
                                        }
                                    }
                                    if game.removable: Button {
                                        text: "Remove";
                                        horizontal-stretch: 1;
                                        enabled: !game.busy;
                                        clicked => {
                                            root.game-remove(i);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Card {
                        title: "Calibration";
                        hint: "";
                        vertical-stretch: 0;
                        Text {
                            text: root.calibration-text;
                            color: Theme.muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        if root.calibration-available: ComboBox {
                            model: root.monitors;
                            current-index <=> root.monitor-index;
                            enabled: !root.calibrating;
                        }
                        if root.calibration-available: Switch {
                            text: "Keep the current screen setup";
                            checked <=> root.keep-display-setup;
                            enabled: !root.calibrating;
                        }
                        if root.calibration-available: Button {
                            text: root.calibrating ? "Calibrating…" : "Calibrate on this monitor";
                            enabled: !root.calibrating;
                            clicked => {
                                root.calibrate();
                            }
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                    }
            
                }
            }

            ScrollView {
                horizontal-stretch: 1;
                VerticalLayout {
                    spacing: 14px;
                    padding-right: 14px;

                    Card {
                        title: "Smoothing";
                        hint: "Steadies the view. More steadiness, more lag at rest.";
                        Switch {
                            text: "Smooth head movement";
                            checked: root.smoothing-enabled;
                            toggled => {
                                root.smoothing-toggled(self.checked);
                            }
                        }
                        Setting {
                            label: "Steadiness";
                            maximum: 100;
                            value: root.steadiness;
                            value-text: root.steadiness-text;
                            enabled: root.smoothing-enabled;
                            changed(v) => {
                                root.steadiness-changed(v);
                            }
                        }
                        Setting {
                            label: "Fast turns";
                            maximum: 100;
                            value: root.response;
                            value-text: root.response-text;
                            enabled: root.smoothing-enabled;
                            changed(v) => {
                                root.response-changed(v);
                            }
                        }
                    }

                    Card {
                        title: "Turning";
                        hint: "Degrees. Tracker → game.";
                        for item[i] in root.rotation: AxisEditor {
                            axis: item;
                            changed(field, v) => {
                                root.axis-changed("rotation", i, field, v);
                            }
                            invert(on) => {
                                root.axis-invert("rotation", i, on);
                            }
                        }
                    }

                    Card {
                        title: "Leaning";
                        hint: "Millimetres. Needs a recentre first.";
                        for item[i] in root.position: AxisEditor {
                            axis: item;
                            changed(field, v) => {
                                root.axis-changed("position", i, field, v);
                            }
                            invert(on) => {
                                root.axis-invert("position", i, on);
                            }
                        }
                    }

                    Card {
                        title: "Gaze overlay";
                        hint: "A mark on screen where you are looking.";
                        Switch {
                            text: "Show where I am looking";
                            checked: root.overlay-enabled;
                            toggled => {
                                root.overlay-toggled(self.checked);
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            height: 32px;
                            Text {
                                text: "Style";
                                color: root.overlay-enabled ? Theme.text : Theme.muted;
                                font-size: 13px;
                                vertical-alignment: center;
                                width: 96px;
                            }
                            ComboBox {
                                model: root.overlay-styles;
                                current-index <=> root.overlay-style-index;
                                enabled: root.overlay-enabled;
                                horizontal-stretch: 1;
                                selected => {
                                    root.overlay-style-selected(self.current-index);
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            height: 32px;
                            Text {
                                text: "Colour";
                                color: root.overlay-enabled ? Theme.text : Theme.muted;
                                font-size: 13px;
                                vertical-alignment: center;
                                width: 96px;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                horizontal-stretch: 1;
                                for fill[i] in root.overlay-colors: VerticalLayout {
                                    alignment: center;
                                    Swatch {
                                        fill: fill;
                                        selected: i == root.overlay-color-index;
                                        enabled: root.overlay-enabled;
                                        picked => {
                                            root.overlay-color-selected(i);
                                        }
                                    }
                                }
                            }
                        }
                        Setting {
                            label: "Size";
                            minimum: 20;
                            maximum: 600;
                            value: root.overlay-size;
                            value-text: root.overlay-size-text;
                            enabled: root.overlay-enabled;
                            changed(v) => {
                                root.overlay-size-changed(v);
                            }
                        }
                        Setting {
                            label: "Opacity";
                            minimum: 5;
                            maximum: 100;
                            value: root.overlay-opacity;
                            value-text: root.overlay-opacity-text;
                            enabled: root.overlay-enabled;
                            changed(v) => {
                                root.overlay-opacity-changed(v);
                            }
                        }
                        Setting {
                            label: "Smoothing";
                            maximum: 100;
                            value: root.overlay-smoothing;
                            value-text: root.overlay-smoothing-text;
                            enabled: root.overlay-enabled;
                            changed(v) => {
                                root.overlay-smoothing-changed(v);
                            }
                        }
                        Setting {
                            label: "Trail";
                            maximum: 100;
                            value: root.overlay-trail;
                            value-text: root.overlay-trail-text;
                            enabled: root.overlay-enabled;
                            changed(v) => {
                                root.overlay-trail-changed(v);
                            }
                        }
                    }

                    Card {
                        title: "Face login camera";
                        hint: "The tracker's infrared picture as a webcam, for Howdy.";
                        Switch {
                            text: "Publish the picture while a program reads it";
                            checked: root.camera-enabled;
                            toggled => {
                                root.camera-toggled(self.checked);
                            }
                        }
                        Text {
                            text: root.camera-status;
                            color: Theme.muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
